{
    "manifest_version": 3,

    "name": "AI Interview Assistant",

    "version": "1.0.0",

    "description": "AI-powered job description analyzer and interview preparation assistant.",

    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],

    "host_permissions": [
        "https://generativelanguage.googleapis.com/*"
    ],

    "action": {
        "default_popup": "popup.html",
        "default_title": "AI Interview Assistant"
    },

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],

    "options_page": "options.html"
}